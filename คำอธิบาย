## **6. เขียนฟังก์ชันสำหรับทดสอบ**

💻 สร้างไฟล์ `math.js` แล้ววางโค้ดนี้

```

function add(a, b) {
    return a + b;
}

function subtract(a, b) {
    return a - b;
}

function multiply(a, b) {
    return a * b;
}

function divide(a, b) {
