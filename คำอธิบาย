## **7. เขียน Unit Tests**

💻 สร้างไฟล์ `math.test.js` แล้ววางโค้ดนี้

```

const {
    add,
    subtract,
    multiply,
    divide
} = require("./math");

describe("Math Functions", () => {

    test("add 2 + 3 should be 5", () => {
        expect(add(2, 3)).toBe(5);
    });

    test("subtract 10 - 4 should be 6", () => {
        expect(subtract(10, 4)).toBe(6);
    });

    test("multiply 3 * 4 should be 12", () => {
        expect(multiply(3, 4)).toBe(12);
    });

    test("divide 10 / 2 should be 5", () => {
        expect(divide(10, 2)).toBe(5);
    });

    test("divide by zero should throw error", () => {
        expect(() => divide(10, 0))
            .toThrow("Cannot divide by zero");
    });

});

```

### **อธิบายโครงสร้าง Test**

```
describe("Math Functions", () => {
    // Test Cases
});
```

`describe()` ใช้จัดกลุ่ม Test Cases ที่เกี่ยวข้องกัน

```
test("add 2 + 3 should be 5", () => {
    expect(add(2, 3)).toBe(5);
});
```

`test()` ใช้สร้าง Test Case ส่วน `expect()` ใช้กำหนดค่าที่ต้องการตรวจสอบ และ `toBe(5)` เป็น Matcher ที่กำหนดว่าผลลัพธ์ต้องเท่ากับ 5

`it()` สามารถใช้แทน `test()` ได้ เช่น

```
it("should add two numbers", () => {
    expect(add(2, 3)).toBe(5);
});
```

